@page "/direcciones"
@attribute [Authorize]
@using CasaVapeApp.Models
@inject AddressService AddressService
@inject IJSRuntime JS

<PageTitle>Mis direcciones - CasaVape</PageTitle>

<h1 class="h3 mb-3">Mis direcciones</h1>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
@if (!string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success alert-dismissible">
        @ok
        <button type="button" class="btn-close" @onclick="() => ok = null"></button>
    </div>
}

@if (loading)
{
    <div class="text-center my-5">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    if (addresses.Count == 0)
    {
        <div class="alert alert-info">Todavía no tenés direcciones cargadas.</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var address in addresses)
            {
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h2 class="h6 card-title">@address.Calle @address.Numero</h2>
                            <p class="card-text mb-1">@address.Ciudad, @address.Provincia</p>
                            <p class="card-text text-muted mb-3">CP: @address.CodigoPostal</p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => Editar(address)">Editar</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => Eliminar(address)">Eliminar</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">@(editando is null ? "Nueva dirección" : $"Editar dirección")</h2>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Provincia</label>
                    <select class="form-select" @bind="request.IdProvincia">
                        <option value="0">Seleccioná una provincia...</option>
                        @foreach (var provincia in provincias)
                        {
                            <option value="@provincia.IdProvincia">@provincia.Nombre</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Ciudad</label>
                    <input class="form-control" @bind="request.Ciudad" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Calle</label>
                    <input class="form-control" @bind="request.Calle" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Número</label>
                    <input class="form-control" @bind="request.Numero" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Código postal</label>
                    <input class="form-control" @bind="request.CodigoPostal" />
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" @onclick="Guardar" disabled="@saving">
                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    @(editando is null ? "Agregar dirección" : "Guardar cambios")
                </button>
                @if (editando is not null)
                {
                    <button class="btn btn-secondary" @onclick="Cancelar" disabled="@saving">Cancelar</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<AddressDto> addresses = new();
    private List<ProvinceDto> provincias = new();
    private CreateAddressRequest request = new();
    private AddressDto? editando;
    private bool loading = true;
    private bool saving;
    private string? error;
    private string? ok;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        loading = false;
    }

    private async Task CargarAsync()
    {
        addresses = await AddressService.GetAddressesAsync();
        if (provincias.Count == 0)
        {
            provincias = await AddressService.GetProvincesAsync();
        }
    }

    private void Editar(AddressDto address)
    {
        editando = address;
        request = new CreateAddressRequest
        {
            IdProvincia = address.IdProvincia,
            Calle = address.Calle,
            Numero = address.Numero,
            Ciudad = address.Ciudad,
            CodigoPostal = address.CodigoPostal
        };
        error = null;
        ok = null;
    }

    private void Cancelar()
    {
        editando = null;
        request = new CreateAddressRequest();
    }

    private async Task Guardar()
    {
        error = null;
        ok = null;

        if (request.IdProvincia <= 0)
        {
            error = "Seleccioná una provincia.";
            return;
        }

        if (string.IsNullOrWhiteSpace(request.Calle) || string.IsNullOrWhiteSpace(request.Ciudad))
        {
            error = "Completá calle y ciudad.";
            return;
        }

        saving = true;
        var result = editando is null
            ? await AddressService.CreateAsync(request)
            : await AddressService.UpdateAsync(editando.IdDireccion, request);
        saving = false;

        if (!result.Ok)
        {
            error = result.Error ?? "No se pudo guardar la dirección.";
            return;
        }

        ok = editando is null ? "Dirección agregada correctamente." : "Dirección actualizada correctamente.";
        editando = null;
        request = new CreateAddressRequest();
        await CargarAsync();
    }

    private async Task Eliminar(AddressDto address)
    {
        error = null;
        ok = null;

        var confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la dirección {address.Calle} {address.Numero}?");
        if (!confirmado)
        {
            return;
        }

        var result = await AddressService.DeleteAsync(address.IdDireccion);
        if (!result.Ok)
        {
            error = result.Error ?? "No se pudo eliminar la dirección.";
            return;
        }

        ok = "Dirección eliminada correctamente.";
        if (editando?.IdDireccion == address.IdDireccion)
        {
            Cancelar();
        }

        await CargarAsync();
    }
}
