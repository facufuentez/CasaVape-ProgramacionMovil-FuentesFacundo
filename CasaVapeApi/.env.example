# Configuracion de CasaVapeApi
# Copiar a .env y completar con valores reales (nunca versionar .env)

# JWT (JWT_SECRET: minimo 32 caracteres aleatorios)
JWT_SECRET=cambiame-por-una-clave-larga-y-aleatoria
JWT_ISSUER=CasaVapeApi
JWT_AUDIENCE=CasaVapeApp

# Google Gemini (chat con IA)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Mercado Pago (Checkout Pro)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BASE_URL=https://api.mercadopago.com
MP_ENVIRONMENT=production

# Base de datos (opcional: sobrescribe appsettings.json)
# CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=E-COMMERCE;Trusted_Connection=True;TrustServerCertificate=True
